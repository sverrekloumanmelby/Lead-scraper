{# Felles ramme for alle e-postrapportene.

   E-postklienter støtter bare et smalt utvalg CSS, så vi holder oss til
   enkel, innebygd styling: ingen eksterne fonter, ingen flexbox/grid, og
   farger som fungerer på hvit bakgrunn. #}
<div style="margin:0;padding:0;background:#f4f5f7;">
<div style="max-width:680px;margin:0 auto;padding:24px 16px;
            font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
            color:#1a1d21;line-height:1.5;">

  <div style="background:#ffffff;border-radius:10px;padding:28px 26px;
              border:1px solid #e3e6ea;">

    <div style="border-bottom:2px solid #1a1d21;padding-bottom:14px;margin-bottom:22px;">
      <div style="font-size:22px;font-weight:700;letter-spacing:-0.02em;">
        {% block overskrift %}{{ tittel }}{% endblock %}
      </div>
      <div style="font-size:13px;color:#6b7280;margin-top:4px;">
        {{ dato_tekst }}
        {% if forrige_dato %}· forrige rapport {{ forrige_dato }}{% endif %}
      </div>
    </div>

    {% block innhold %}{% endblock %}

    <div style="margin-top:30px;padding-top:14px;border-top:1px solid #e3e6ea;
                font-size:11px;color:#9099a5;">
      Automatisk generert av investeringsassistenten.
      Dette er ikke investeringsrådgivning — tallene er hentet fra offentlige
      kilder og kan inneholde feil. Kontroller alltid mot selskapets egen
      rapportering før du handler.
    </div>
  </div>
</div>
</div>
