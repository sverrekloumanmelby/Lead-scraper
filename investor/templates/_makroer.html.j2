{# Gjenbrukbare byggeklosser for rapportmalene. #}

{% macro fargetekst(verdi, tekst) %}
  {%- set f = verdi | farge -%}
  {%- if f == 'opp' -%}
    <span style="color:#0f7b3d;font-weight:600;">{{ tekst }}</span>
  {%- elif f == 'ned' -%}
    <span style="color:#c0392b;font-weight:600;">{{ tekst }}</span>
  {%- else -%}
    <span style="color:#6b7280;">{{ tekst }}</span>
  {%- endif -%}
{% endmacro %}

{% macro merkelapp(tekst, bakgrunn, farge) %}
<span style="display:inline-block;background:{{ bakgrunn }};color:{{ farge }};
             font-size:11px;font-weight:600;padding:2px 8px;border-radius:10px;
             letter-spacing:0.02em;">{{ tekst }}</span>
{% endmacro %}

{% macro viktighetsmerke(viktighet) %}
  {%- if viktighet >= 3 -%}
    {{ merkelapp('VIKTIG', '#fdecea', '#c0392b') }}
  {%- elif viktighet == 2 -%}
    {{ merkelapp('VERDT Å VITE', '#fff6e5', '#96650a') }}
  {%- endif -%}
{% endmacro %}

{% macro prioritetsmerke(prioritet) %}
  {%- if prioritet == 'HØY' -%}
    {{ merkelapp('HØY', '#e8f5ed', '#0f7b3d') }}
  {%- elif prioritet == 'MIDDELS' -%}
    {{ merkelapp('MIDDELS', '#eef2f7', '#3b5573') }}
  {%- else -%}
    {{ merkelapp('LAV', '#f2f3f5', '#6b7280') }}
  {%- endif -%}
{% endmacro %}

{% macro seksjonstittel(tekst) %}
<div style="font-size:15px;font-weight:700;margin:26px 0 12px;
            padding-bottom:6px;border-bottom:1px solid #e3e6ea;">{{ tekst }}</div>
{% endmacro %}

{# Én hendelse. #}
{% macro hendelse_rad(h) %}
<div style="padding:9px 0;border-bottom:1px solid #f0f1f3;">
  <div style="font-size:14px;">
    {{ viktighetsmerke(h.viktighet) }}
    {% if h.url %}
      <a href="{{ h.url }}" style="color:#1a1d21;text-decoration:none;">{{ h.tittel }}</a>
    {% else %}
      {{ h.tittel }}
    {% endif %}
  </div>
  {% if h.detalj %}
  <div style="font-size:12px;color:#6b7280;margin-top:2px;">{{ h.detalj }}</div>
  {% endif %}
</div>
{% endmacro %}

{# Kursrad for ett selskap. #}
{% macro kursrad(post) %}
{% set s = post.status %}
{% set k = s.kurs %}
<tr>
  <td style="padding:9px 8px 9px 0;border-bottom:1px solid #f0f1f3;">
    <div style="font-weight:600;font-size:14px;">{{ s.navn }}</div>
    <div style="font-size:11px;color:#9099a5;">{{ s.ticker }}</div>
  </td>
  <td style="padding:9px 8px;border-bottom:1px solid #f0f1f3;
             text-align:right;font-size:14px;white-space:nowrap;">
    {% if k and k.pris %}{{ k.pris | kr(k.valuta) }}{% else %}–{% endif %}
  </td>
  <td style="padding:9px 8px;border-bottom:1px solid #f0f1f3;
             text-align:right;font-size:13px;white-space:nowrap;">
    {{ fargetekst(k.endring_1d if k else none, (k.endring_1d if k else none) | pst) }}
  </td>
  <td style="padding:9px 0 9px 8px;border-bottom:1px solid #f0f1f3;
             text-align:right;font-size:13px;white-space:nowrap;">
    {{ fargetekst(k.endring_ytd if k else none, (k.endring_ytd if k else none) | pst) }}
  </td>
</tr>
{% endmacro %}

{# Én kandidat med tallfestede begrunnelser. #}
{% macro kandidat_kort(kand, er_ny) %}
<div style="border:1px solid #e3e6ea;border-radius:8px;padding:15px 16px;
            margin-bottom:12px;background:#fcfcfd;">
  <div style="margin-bottom:3px;">
    {{ prioritetsmerke(kand.prioritet) }}
    {% if er_ny %}{{ merkelapp('NY', '#eaf1fb', '#1d4ed8') }}{% endif %}
    <span style="font-size:11px;color:#9099a5;margin-left:4px;">score {{ kand.score }}/100</span>
  </div>
  <div style="font-size:16px;font-weight:700;">{{ kand.navn }}</div>
  <div style="font-size:12px;color:#6b7280;margin-bottom:10px;">
    {{ kand.ticker }}
    {% if kand.fundamentals.bors %} · {{ kand.fundamentals.bors }}{% endif %}
    {% if kand.fundamentals.sektor %} · {{ kand.fundamentals.sektor }}{% endif %}
    {% if kand.fundamentals.borsverdi %}
      · {{ kand.fundamentals.borsverdi | stort_tall(kand.fundamentals.valuta) }}
    {% endif %}
  </div>

  <div style="font-size:13px;font-weight:600;margin-bottom:5px;">
    Kan være et godt kjøp fordi:
  </div>
  <ul style="margin:0 0 10px;padding-left:18px;font-size:13px;color:#33383f;">
    {% for grunn in kand.grunner %}
    <li style="margin-bottom:3px;">{{ grunn }}</li>
    {% endfor %}
  </ul>

  <table style="width:100%;border-collapse:collapse;font-size:11px;color:#6b7280;">
    <tr>
      {% for navn, verdi in kand.delscorer.items() %}
      <td style="padding:3px 4px;text-align:center;">
        <div style="text-transform:capitalize;">{{ navn }}</div>
        <div style="font-weight:700;color:#33383f;font-size:12px;">
          {{ (verdi * 100) | round | int }}
        </div>
      </td>
      {% endfor %}
    </tr>
  </table>
</div>
{% endmacro %}
