{# Daglig e-post: kort. Kun det som er genuint verdt å vite. #}
{% extends "_base.html.j2" %}
{% import "_makroer.html.j2" as m %}

{% block innhold %}

{% if totalt_hendelser == 0 %}

  <div style="background:#f7f8fa;border-radius:8px;padding:18px 20px;
              font-size:14px;color:#4b5563;">
    <strong style="color:#1a1d21;">Rolig dag.</strong>
    Ingenting som krever oppmerksomhet i porteføljen din i dag — ingen store
    kursbevegelser, ingen resultater og ingen vesentlige nyheter.
  </div>

{% else %}

  {% for post in selskaper %}
    {% if post.hendelser %}
    <div style="margin-bottom:20px;">
      <div style="font-size:15px;font-weight:700;">
        {{ post.status.navn }}
        <span style="font-size:12px;font-weight:400;color:#9099a5;">
          {{ post.status.ticker }}
        </span>
        {% if post.status.kurs and post.status.kurs.pris %}
        <span style="font-size:13px;font-weight:400;float:right;">
          {{ post.status.kurs.pris | kr(post.status.kurs.valuta) }}
          {{ m.fargetekst(post.status.kurs.endring_1d, post.status.kurs.endring_1d | pst) }}
        </span>
        {% endif %}
      </div>
      {% for h in post.hendelser %}
        {{ m.hendelse_rad(h) }}
      {% endfor %}
    </div>
    {% endif %}
  {% endfor %}

{% endif %}

{# Kort kurslinje nederst, så du alltid ser hvor du står. #}
{{ m.seksjonstittel('Porteføljen i dag') }}
<table style="width:100%;border-collapse:collapse;">
  <tr style="font-size:11px;color:#9099a5;text-align:left;">
    <th style="padding-bottom:5px;font-weight:500;">Selskap</th>
    <th style="padding-bottom:5px;font-weight:500;text-align:right;">Kurs</th>
    <th style="padding-bottom:5px;font-weight:500;text-align:right;">I dag</th>
    <th style="padding-bottom:5px;font-weight:500;text-align:right;">Hittil i år</th>
  </tr>
  {% for post in selskaper %}
    {{ m.kursrad(post) }}
  {% endfor %}
</table>

{% if sammendrag.har_verdier %}
<div style="margin-top:12px;font-size:13px;color:#4b5563;">
  Samlet verdi {{ sammendrag.verdi | kr }} ·
  urealisert {{ m.fargetekst(sammendrag.gevinst, (sammendrag.gevinst | kr) + ' (' + (sammendrag.gevinst_pst | pst) + ')') }}
</div>
{% endif %}

{% endblock %}
